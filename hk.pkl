amends "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/helpers.pkl"

local picked =
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "tsc"
    "github-actions"
    "tombi"
    "rumdl"
    "yaml"
    "typos"
    "hygiene"
  })

local yaml = picked["yaml"] as Group

steps = (picked) {
  ["oxfmt"] = (picked["oxfmt"] as Step) {
    // Native mise manifests and lockfiles must retain their generated bytes.
    exclude = (picked["oxfmt"] as Step).exclude!! + List(".mise/locks/**/package.json", ".mise/locks/**/aube-lock.yaml")
  }
  ["yaml"] = (yaml) {
    steps = (yaml.steps) {
      ["yamllint"] = (yaml.steps["yamllint"]) {
        exclude = (yaml.steps["yamllint"] as Step).exclude!! + List(".mise/locks/**/aube-lock.yaml")
      }
      ["yamlfmt"] = (yaml.steps["yamlfmt"]) {
        exclude = (yaml.steps["yamlfmt"] as Step).exclude!! + List(".mise/locks/**/aube-lock.yaml")
      }
    }
  }
}
